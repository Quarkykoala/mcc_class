{
    "name": "mcc_class",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev -w @mcc/api\" \"npm run dev -w web\"",
        "build": "npm run build -w @mcc/api && npm run build -w web",
        "lint": "npm run lint -w @mcc/api && npm run lint -w web",
        "test": "npm run test -w @mcc/api",
        "test:web": "npm run test:e2e -w web"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/supertest": "^6.0.3",
        "concurrently": "^9.2.1",
        "supertest": "^7.2.2"
    }
}
