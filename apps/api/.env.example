MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mcc
JWT_SECRET=<your-jwt-secret>
PORT=3000
CLIENT_URL=http://localhost:5173
ALLOW_REGISTRATION=false
# Verification key for public verification endpoint
# Leave VERIFY_ACCESS_KEY unset if you want public demo QR verification to work without a key.
# VERIFY_ACCESS_KEY=dev-verify-key-12345

# Demo mode should stay false on a client server.
DEMO_MODE=false
